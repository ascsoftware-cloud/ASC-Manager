# Public (browser). Safe to expose. Never put the service role here.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Canonical app URL for invite + password-reset redirects.
# Must include http:// or https://. No trailing slash.
# Local: http://localhost:8080
# Live:  https://manager.ascsoftware.co.za
VITE_APP_URL=http://localhost:8080

# Server only. Never prefix with VITE_. Never commit the real value.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_URL=https://YOUR-PROJECT.supabase.co

# One-time operator invites: npm run bootstrap:operators
# ASC_OPERATOR_EMAIL=tiaan@ascsoftware.co.za
# ASC_OPERATOR_NAME=Tiaan Schoeman
# ASC_OPERATOR_EMAIL_2=gregory@ascsoftware.co.za
# ASC_OPERATOR_NAME_2=Gregory

# Staging example tenants only. Never set this in production.
# ASC_ALLOW_SEED=true
